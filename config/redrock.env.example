# Exemple : install.sh génère config/redrock.env (droits 600). Lu par le broker et par l'app.
# Pas de commentaire en fin de ligne : l'app lit ces valeurs telles quelles.
#
# paper = simulation sur les vrais prix ; live = argent réel
MODE=paper
GENERATION=1
# adresse du sous-compte Hyperliquid (live) ; en simulation, une adresse nulle suffit
HL_SUBACCOUNT=0x0000000000000000000000000000000000000000
# capital de départ simulé, en $ (paper)
PAPER_CAPITAL=100
# mort immédiate si l'equity passe sous ce montant
DEATH_EQUITY=1
# règle de mort : drawdown = mort si l'equity tombe sous (1 - DD_TOLERANCE) × son plus haut de la génération
TRAJ_RULE=on
DEATH_MODE=drawdown
DD_TOLERANCE=0.35
# rythme visé par jour, en % (repère affiché, pas une règle de mort)
DAILY_TARGET_PCT=1
OPENROUTER_API_KEY=
